generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  AI_SYSTEM_OWNER
  RISK_COMPLIANCE_AUDITOR
  GOVERNANCE_APPROVER
  VIEWER
}

enum AiSystemStatus {
  DRAFT
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
  SUSPENDED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AutonomyLevel {
  ASSISTIVE
  HUMAN_IN_THE_LOOP
  HUMAN_ON_THE_LOOP
  AUTONOMOUS
}

enum LifecycleStage {
  IDEA
  DEVELOPMENT
  PILOT
  PRODUCTION
  RETIRED
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum ComplianceAuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ComplianceResult {
  CONFORMING
  PARTIALLY_CONFORMING
  NON_CONFORMING
  NOT_APPLICABLE
}

enum ControlImplementationStatus {
  RECOMMENDED
  PLANNED
  IMPLEMENTED
  NOT_APPLICABLE
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GovernanceDecisionType {
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
  SUSPENDED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum AuditEventType {
  USER_CREATED
  SYSTEM_REGISTERED
  ASSESSMENT_SUBMITTED
  ASSESSMENT_VERIFIED
  AUDIT_UPDATED
  CONTROL_ASSIGNED
  ACTION_UPDATED
  SYSTEM_SUBMITTED
  GOVERNANCE_DECISION_RECORDED
  SYSTEM_SUSPENDED
  INCIDENT_REPORTED
  INCIDENT_UPDATED
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String     @unique
  description String?
  users       User[]
  aiSystems   AiSystem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  avatarDataUrl       String?
  passwordHash        String?
  role                UserRole
  active              Boolean              @default(true)
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownedSystems        AiSystem[]           @relation("SystemOwner")
  riskAssessments     RiskAssessment[]     @relation("AssessmentAssessor")
  complianceAudits    ComplianceAudit[]    @relation("ComplianceAuditor")
  assignedActions     CorrectiveAction[]   @relation("ActionAssignee")
  createdActions      CorrectiveAction[]   @relation("ActionCreator")
  governanceDecisions GovernanceDecision[]
  auditEvents         AuditEvent[]
  reportedIncidents   Incident[]            @relation("IncidentReporter")
  assignedIncidents   Incident[]            @relation("IncidentAssignee")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([departmentId])
  @@index([role, active])
}

model AiSystem {
  id                  String               @id @default(cuid())
  referenceId         String               @unique
  name                String
  description         String
  purpose             String
  intendedUsers       String
  dataCategories      String[]
  modelProvider       String?
  modelName           String?
  lifecycleStage      LifecycleStage
  autonomyLevel       AutonomyLevel
  usesPersonalData    Boolean              @default(false)
  usesSensitiveData   Boolean              @default(false)
  hasMaterialImpact   Boolean              @default(false)
  status              AiSystemStatus       @default(DRAFT)
  riskScore           Int                  @default(0)
  riskLevel           RiskLevel            @default(LOW)
  complianceScore     Int                  @default(0)
  lastAssessedAt      DateTime?
  submittedAt         DateTime?
  departmentId        String
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerId             String
  owner               User                 @relation("SystemOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  riskAssessments     RiskAssessment[]
  complianceAudits    ComplianceAudit[]
  recommendedControls AiSystemControl[]
  correctiveActions   CorrectiveAction[]
  governanceDecisions GovernanceDecision[]
  auditEvents         AuditEvent[]
  incidents           Incident[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([departmentId])
  @@index([ownerId])
  @@index([status, riskLevel])
  @@index([createdAt])
}

model RiskAssessment {
  id               String           @id @default(cuid())
  version          Int              @default(1)
  status           AssessmentStatus @default(DRAFT)
  answers          Json
  score            Int
  riskLevel        RiskLevel
  summary          String?
  submittedAt      DateTime?
  verifiedAt       DateTime?
  aiSystemId       String
  aiSystem         AiSystem         @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  assessorId       String
  assessor         User             @relation("AssessmentAssessor", fields: [assessorId], references: [id], onDelete: Restrict)
  triggeredFactors RiskFactor[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([aiSystemId, version])
  @@index([assessorId])
}

model RiskFactor {
  id             String         @id @default(cuid())
  ruleKey        String
  label          String
  points         Int
  recommendation String
  assessmentId   String
  assessment     RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([assessmentId, ruleKey])
}

model Control {
  id               String            @id @default(cuid())
  code             String            @unique
  title            String
  description      String
  category         String
  evidenceGuidance String?
  active           Boolean           @default(true)
  systemControls   AiSystemControl[]
  complianceChecks ComplianceCheck[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model AiSystemControl {
  id           String                      @id @default(cuid())
  status       ControlImplementationStatus @default(RECOMMENDED)
  rationale    String
  evidenceNote String?
  aiSystemId   String
  aiSystem     AiSystem                    @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  controlId    String
  control      Control                     @relation(fields: [controlId], references: [id], onDelete: Restrict)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([aiSystemId, controlId])
  @@index([controlId])
}

model ComplianceAudit {
  id          String                @id @default(cuid())
  title       String
  status      ComplianceAuditStatus @default(PLANNED)
  score       Int?
  summary     String?
  startedAt   DateTime?
  completedAt DateTime?
  aiSystemId  String
  aiSystem    AiSystem              @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  auditorId   String
  auditor     User                  @relation("ComplianceAuditor", fields: [auditorId], references: [id], onDelete: Restrict)
  checks      ComplianceCheck[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([aiSystemId, status])
  @@index([auditorId])
}

model ComplianceCheck {
  id        String           @id @default(cuid())
  result    ComplianceResult
  finding   String?
  evidence  String?
  auditId   String
  audit     ComplianceAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  controlId String
  control   Control          @relation(fields: [controlId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([auditId, controlId])
  @@index([controlId])
}

model CorrectiveAction {
  id          String                 @id @default(cuid())
  title       String
  description String
  priority    ActionPriority
  status      CorrectiveActionStatus @default(OPEN)
  dueDate     DateTime?
  completedAt DateTime?
  evidenceNote String?
  aiSystemId  String
  aiSystem    AiSystem               @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?                  @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User                   @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([aiSystemId, status])
  @@index([assigneeId, status])
}

model GovernanceDecision {
  id            String                 @id @default(cuid())
  decision      GovernanceDecisionType
  justification String
  conditions    String?
  decidedAt     DateTime               @default(now())
  aiSystemId    String
  aiSystem      AiSystem               @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  approverId    String
  approver      User                   @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([aiSystemId, decidedAt])
  @@index([approverId])
}

model Incident {
  id            String           @id @default(cuid())
  title         String
  description   String
  severity      IncidentSeverity
  status        IncidentStatus   @default(OPEN)
  occurredAt    DateTime
  reportedAt    DateTime         @default(now())
  resolvedAt    DateTime?
  resolutionNote String?
  aiSystemId    String
  aiSystem      AiSystem         @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User             @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assigneeId    String?
  assignee      User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([aiSystemId, status])
  @@index([assigneeId, status])
  @@index([status, severity])
}

model AuditEvent {
  id         String         @id @default(cuid())
  eventType  AuditEventType
  summary    String
  entityType String
  entityId   String
  metadata   Json?
  occurredAt DateTime       @default(now())
  aiSystemId String?
  aiSystem   AiSystem?      @relation(fields: [aiSystemId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([aiSystemId, occurredAt])
  @@index([actorId])
  @@index([entityType, entityId])
}
